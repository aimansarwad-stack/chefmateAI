# ──────────────────────────────────────────────
#  ChefMate AI – Environment Variables Example
#  Copy this file to .env and fill in your key.
# ──────────────────────────────────────────────

# 🔑 Your Groq API key
# Get one free at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# 🤖 Groq model to use (available on your account):
#   openai/gpt-oss-120b   → Most capable (default)
#   openai/gpt-oss-20b    → Faster & lighter
#   qwen/qwen3.8-27b      → Qwen 3 27B
#   allam-2-7b            → IBM Allam 7B
GROQ_MODEL=openai/gpt-oss-120b
